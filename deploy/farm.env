# ============================================================
#  phone-farm 统一配置（唯一配置文件）
#  用法：改这里 → `phone-farm restart` 生效；`phone-farm config` 看当前生效值
#  位置：/usr/local/share/phone-farm/farm.env
#
#  ⚠️ 约定：**不要写行内注释**（`KEY=值  # 说明`）。
#     systemd 的 EnvironmentFile 不会去掉 `#` 之后的内容，值会变成
#     "1200 # 说明"，程序 int() 解析必然崩（2026-10-16 真实故障）。
#     注释一律独立成行。
# ============================================================

# ---------- 端口（89xx 手机农场段）----------
# 农场 API：设备清单 / 能力集 / 租约 / 体检 / exec
PHONE_FARM_PORT_HUB=8901
# 一句话总入口（LLM agent）
PHONE_FARM_PORT_AGENT=8902
# 手机墙（人用主界面，内嵌高清流）
PHONE_FARM_PORT_WALL=8910
# H.264 视频流后端（ws-scrcpy 写死该端口，墙会自动对准）
PHONE_FARM_PORT_SCRCPY=8000

# ---------- 租约与僵尸回收（秒）----------
# 租约最长占用（不续心跳就到期）
PHONE_HUB_TTL=900
# 空闲多久收回（期间无任何设备动作）
PHONE_HUB_IDLE_RECLAIM=600
# 画面长时间不变也收回
PHONE_HUB_STILL_RECLAIM=900
# 心跳中断多久算失联
PHONE_HUB_HB_GRACE=90
# 心跳还在、但设备多久没动作算「卡死」（LLM 挂住）
PHONE_HUB_STALL_AFTER=120
# 判定卡死后多久强制收回
PHONE_HUB_STALL_RECLAIM=300
# 离线多久从设备列表删除（老化清理，默认 24 小时）
PHONE_HUB_OFFLINE_PRUNE=86400

# ---------- 手机 agent ----------
# 单任务最多 LLM 轮次
PHONE_AGENT_MAX_STEPS=24
# 同一台机器上第二个任务最多排队等待（秒）
PHONE_AGENT_QUEUE_WAIT=600
# 单任务总超时（秒）
PHONE_AGENT_DEADLINE=1200
# LLM 服务地址（复用 BU 的网关）
LLM_BASE_URL=http://131.255.36.100:30001/v1
# 模型名
LLM_MODEL=deepseek-flash
# 单次 LLM 调用超时（秒）
LLM_TIMEOUT=120

# ---------- 其它 ----------
# agent 访问农场 API 的地址
PHONE_HUB_BASE=http://127.0.0.1:8901

# ============================================================
#  phone-farm 统一配置（唯一配置文件）
#  用法：改这里 → `phone-farm restart` 生效；`phone-farm config` 看当前生效值
#  放在 /usr/local/share/phone-farm/farm.env，各服务以 EnvironmentFile 读取
# ============================================================

# ---------- 端口（89xx 手机农场段）----------
PHONE_FARM_PORT_HUB=8901          # 农场 API：设备清单/能力/租约/体检/exec
PHONE_FARM_PORT_AGENT=8902        # 一句话总入口（LLM agent）
PHONE_FARM_PORT_WALL=8910         # 手机墙（人用主入口，内嵌高清流）
PHONE_FARM_PORT_SCRCPY=8000       # H.264 视频流后端（ws-scrcpy 写死，墙自动对准）
PHONE_FARM_PORT_PROXY=7890        # 出网代理（mihomo）

# ---------- 租约与僵尸回收（秒）----------
PHONE_HUB_TTL=900                 # 租约最长占用（不续心跳就到期）
PHONE_HUB_IDLE_RECLAIM=600        # 空闲多久收回（无设备动作）
PHONE_HUB_STILL_RECLAIM=900       # 画面长时间不变也收回
PHONE_HUB_HB_GRACE=90             # 心跳中断多久算失联
PHONE_HUB_STALL_AFTER=120         # 心跳还在、但设备多久没动作算"卡死"
PHONE_HUB_STALL_RECLAIM=300       # 卡死后多久强制收回
PHONE_HUB_OFFLINE_PRUNE=86400     # 离线多久从列表删除（老化清理，默认 24h）

# ---------- 手机 agent ----------
PHONE_AGENT_MAX_STEPS=24          # 单任务最多 LLM 轮次
PHONE_AGENT_QUEUE_WAIT=600        # 同一台机器上第二个任务最多排队等多久
PHONE_AGENT_DEADLINE=1200         # 单任务总超时（秒）
LLM_BASE_URL=http://131.255.36.100:30001/v1
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=120

# ---------- 其它 ----------
PHONE_HUB_BASE=http://127.0.0.1:8901

# phone-hub 的租约/回收参数（改完 systemctl restart phone-hub 生效）
# 租约默认有效期（秒）：到点自动释放
PHONE_HUB_TTL=900
# 无心跳且无动作超过这个秒数 → 判定"agent 死了/页面关了" → 自动收回终端
PHONE_HUB_IDLE_RECLAIM=600
# 屏幕指纹长时间无变化（且最近无动作）→ 判定僵尸占用 → 收回
PHONE_HUB_STILL_RECLAIM=900
# 心跳新鲜度阈值（秒）：超过就认为"人/agent 可能已不在了"（仅用于展示与判定参考）
PHONE_HUB_HB_GRACE=90
# 【关键】心跳还在但设备长时间无动作 → 判定 LLM 服务器挂了/任务挂死（进程没死、心跳照跳，只有这个能救）
# 多久无动作算"疑似卡死"（只做展示与预警）
PHONE_HUB_STALL_AFTER=120
# 多久无动作就强制收回（注意：心跳不再刷新"最后活动"，只有真正操作设备才算活动）
PHONE_HUB_STALL_RECLAIM=300
# 离线多久后从设备列表删除（老化清理；手机墙也不再显示）
PHONE_HUB_OFFLINE_PRUNE=86400
